{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/",               "destination": "/sites/index.html" },
    { "source": "/calyx",          "destination": "/sites/calyx.html" },
    { "source": "/hyperborea",     "destination": "/sites/hyperborea.html" },
    { "source": "/horai",          "destination": "/sites/horai.html" },
    { "source": "/before-ai-slop", "destination": "/sites/before-ai-slop.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
